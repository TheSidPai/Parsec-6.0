# Environment Variables for Parsec Frontend

# API Base URL
# IMPORTANT: For development, you should use the deployed backend with OAuth configured
# Uncomment the line below to use the production backend (recommended for testing OAuth)
# REACT_APP_API_URL=https://parsec.iitdh.ac.in/api/parsec/v1

# For local development (ONLY if your local backend has Google OAuth configured):
# REACT_APP_API_URL=http://localhost:3000/api/parsec/v1

# Leave commented to use proxy (default)
